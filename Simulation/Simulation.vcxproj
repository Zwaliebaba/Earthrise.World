  <!-- The server half of the bake (ADR-016, decision 5): GameData's server sources to <outputdir>\ServerData\ServerData.bin,
       beside every executable and test DLL, since every consumer of the server's data references this project. The
       inputs are everything the server half reads: the palette, the templates, the rules, the script and the modules
       it imports, and nothing under GameData\Client. It writes the file only when its bytes change. -->
  <ItemGroup>
    <BakeInput Include="$(SolutionDir)GameData\Server\Palette.json" />
    <BakeInput Include="$(SolutionDir)GameData\Server\Rules.json" />
    <BakeInput Include="$(SolutionDir)GameData\Server\Templates\*.json" />
    <BakeInput Include="$(SolutionDir)Tools\BakeContent.py" />
    <BakeInput Include="$(SolutionDir)Tools\CheckAssets.py" />
    <BakeInput Include="$(SolutionDir)Tools\VoxFile.py" />
  </ItemGroup>
  <Target Name="BakeServerData" BeforeTargets="ClCompile" Inputs="@(BakeInput)" Outputs="$(OutDir)ServerData\ServerData.bin">
    <Exec Command="python &quot;$(SolutionDir)Tools\BakeContent.py&quot; --server &quot;$(OutDir)ServerData&quot; || (echo error: the server bake failed, see its output above; it needs Python 3.12 or later on PATH, ADR-016 &amp;&amp; exit 1)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
